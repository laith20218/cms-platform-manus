coverage/
*.lcov
.nyc_output/
test-results/
test-output/

# === Logs ===
logs/
*.log
pnpm-debug.log*

# === Temporary Files ===
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# === OS Files ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

