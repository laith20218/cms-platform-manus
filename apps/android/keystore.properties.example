# Copy this file to keystore.properties (same directory) and fill in your LOCAL
# values. keystore.properties is GITIGNORED and must NEVER be committed.
# Full instructions: docs/android-signing-notes.md
#
# storeFile — absolute path to your keystore, OUTSIDE this repository.
#             (A relative path resolves from apps/android/ ; absolute is safer.)
# All values below are placeholders: replace every CHANGE_ME.
storeFile=/absolute/path/outside/repo/cms-student-upload.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
