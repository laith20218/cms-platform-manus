<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Batch 4: connectivity probe for the media cache (online/offline entitlement decisions). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CmsApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CmsStudent">
        <activity
            android:name=".OfflineExamActivity"
            android:exported="false" />
        <!-- W3 (UX 2A): the WebView offline-exam player for question packages —
             FLAG_SECURE, in-app only, and noHistory so it never lingers in the
             back stack after the student leaves it. -->
        <activity
            android:name=".OfflineExamWebActivity"
            android:exported="false"
            android:noHistory="true" />
        <!-- W5b-ii (Phase Q): chunked offline course-episode player — FLAG_SECURE,
             loopback-only reassembly channel, in-app only, never in recents. -->
        <activity
            android:name=".OfflineCoursePlayerActivity"
            android:exported="false"
            android:noHistory="true" />
        <!-- Batch 1: the phone/password offline entry is no longer the LAUNCHER.
             It stays reachable only via explicit intent from inside the app or
             adb (am start -n com.cms.student/.MainActivity). -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <!-- Hybrid WebView shell: normal cold start lands here. configChanges keep
             the WebView (and its session) alive across rotation and UI-mode changes. -->
        <activity
            android:name=".shell.ShellActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Batch 4: in-app, FLAG_SECURE media viewers for cached objects (owner lock 5:
             native in-app only; no external viewer, no file share). All exported=false —
             reachable only from inside the app (bridge openLocal / offline catalog). -->
        <activity
            android:name=".media.PdfViewActivity"
            android:exported="false" />
        <activity
            android:name=".media.TextReaderActivity"
            android:exported="false" />
        <activity
            android:name=".media.AudioPlayerActivity"
            android:exported="false" />
        <activity
            android:name=".media.VideoPlayerActivity"
            android:exported="false" />
        <activity
            android:name=".media.ImageViewerActivity"
            android:exported="false" />
        <activity
            android:name=".media.OfflineCatalogActivity"
            android:exported="false" />
    </application>
</manifest>
