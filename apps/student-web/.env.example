# ============================================================
# student-web — E2E Environment Variables Template
# Copy to .env (gitignored) or export in CI secrets; never commit
# real values. Used by e2e/*.spec.ts and playwright.config.ts.
# ============================================================

# Base URL of the student-web deployment under test (playwright.config.ts)
E2E_WEB_URL=

# Backend API base URL used by e2e flows
E2E_API_URL=

# Seeded student test-account phone (e2e/student.spec.ts)
E2E_STUDENT_PHONE=

# Seeded student test-account password (e2e/student.spec.ts)
E2E_STUDENT_PASSWORD=

# Seeded admin test-account email (e2e/admin.spec.ts)
E2E_ADMIN_EMAIL=

# Seeded admin test-account password (e2e/admin.spec.ts)
E2E_ADMIN_PASSWORD=

# Pre-seeded device fingerprint for student device binding (e2e/helpers/device-binding.ts)
E2E_DEVICE_FINGERPRINT=
