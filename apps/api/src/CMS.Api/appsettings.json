{
  "ConnectionStrings": {
    "PostgreSQL": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "CMS",
    "Audience": "CMS-Users",
    "Secret": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Features": {
    "OtpEnabled": false,
    "OfflineEnabled": false,
    "OfflineAesGcmImplemented": false,
    "OfflineManifestImplemented": false,
    "OfflineKeyReleaseImplemented": false,
    "OfflinePackageIssuanceImplemented": false,
    "OfflineTrustedClientImplemented": false
  },
  "Security": {
    "PlayIntegrity": {
      "Enabled": false
    },
    "Audit": {
      "BatchSize": 50,
      "FlushSeconds": 60,
      "QueueCapacity": 1000,
      "RetentionDays": 365,
      "RetentionRunIntervalHours": 24
    }
  },
  "Cors": {
    "StudentApp": "https://app.cms.example.com",
    "AdminApp": "https://admin.cms.example.com"
  },
  "Cloudflare": {
    "R2": {
      "AccountId": "your-account-id",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "cms-files",
      "PublicUrl": "https://cdn.cms.example.com"
    }
  },
  "Firebase": {
    "ProjectId": "cms-project",
    "ServiceAccountKeyPath": ""
  },
  "WhatsApp": {
    "ApiUrl": "https://api.whatsapp.com",
    "Token": "",
    "PhoneNumberId": "your-phone-number-id"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
