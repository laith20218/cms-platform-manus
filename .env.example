# ============================================================
# CMS Platform — Environment Variables Template
# Copy this file to `.env` and fill in real values
# NEVER commit the actual .env file
# ============================================================

# ===== Application =====
NODE_ENV=development
APP_VERSION=1.0.0
TZ=Asia/Riyadh

# ===== PostgreSQL =====
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=<set-locally-in-your-secret-store>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== Upstash Redis REST (cache — still active, unrelated to file storage) =====
# Local Redis is not configured by this production adapter; use a REST-compatible test endpoint.
UPSTASH__REDIS__RESTURL=<set-locally-in-your-secret-store>
UPSTASH__REDIS__RESTTOKEN=<set-locally-in-your-secret-store>

# ===== RETIRED: Upstash Blob Storage (PUSH 10.9) =====
# Upstash hit its 1GB free-tier limit and the account is read-only. The supervisor
# removed the Upstash:Blob variables; S3StorageService (Backblaze B2, below) is now
# the ONLY storage provider. The variables below are kept ONLY for a documented
# rollback path — setting UPSTASH__BLOB__TOKEN no longer has any effect (the DI
# conditional was deleted by PUSH 10.9; see DependencyInjection.cs).
# UPSTASH__BLOB__TOKEN=<retired-by-push-10.9>
# UPSTASH__BLOB__S3ENDPOINT=<retired-by-push-10.9>

# ===== JWT =====
JWT_SECRET=<generate-a-unique-32-byte-minimum-secret-locally>
JWT_ISSUER=CMS
JWT_AUDIENCE=CMS-Users
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ===== CORS (Frontend URLs) =====
CORS_STUDENT_APP=http://localhost:5173
CORS_ADMIN_APP=http://localhost:5174

# ===== Vite Frontend =====
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# ===== S3-Compatible Private Storage — ACTIVE PROVIDER (PUSH 10.9: Backblaze B2) =====
# S3StorageService reads Storage:S3:* (the Storage__S3__* variables on Render —
# .NET maps the double underscore to the configuration hierarchy; case-insensitive).
# Production: bucket CMSmedia @ eu-central-003 on Backblaze B2.
# AccessKey/SecretKey = the B2 application keyID / applicationKey pair.
# All five values are REQUIRED — the service fails closed at startup when any is empty.
Storage__S3__Endpoint=https://s3.eu-central-003.backblazeb2.com
Storage__S3__Region=eu-central-003
Storage__S3__AccessKey=<set-locally-in-your-secret-store>
Storage__S3__SecretKey=<set-locally-in-your-secret-store>
Storage__S3__BucketName=CMSmedia

# ===== WhatsApp Business API (OTP) =====
WHATSAPP_TOKEN=<set-locally-in-your-secret-store>
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# ===== Firebase (Push Notifications) =====
FIREBASE_PROJECT_ID=cms-project
FIREBASE_SERVICE_ACCOUNT=<set-a-secret-manager-reference-locally>

# ===== Sentry (Error Monitoring) =====
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=development

# ===== Rate Limiting =====
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=5

# ===== Logging =====
LOG_LEVEL=Information
LOG_PATH=/app/logs

# ===== Feature Flags =====
FEATURE_OFFLINE_MODE=false
FEATURE_WATERMARK=true
FEATURE_DEVTOOLS_DETECTION=true
