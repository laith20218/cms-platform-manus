# ============================================================
# CMS Platform — Environment Variables Template
# Copy this file to `.env` and fill in real values
# NEVER commit the actual .env file
# ============================================================

# ===== Application =====
NODE_ENV=development
APP_VERSION=1.0.0
TZ=Asia/Riyadh

# ===== PostgreSQL =====
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=<set-locally-in-your-secret-store>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== Upstash Redis REST =====
# Local Redis is not configured by this production adapter; use a REST-compatible test endpoint.
UPSTASH__REDIS__RESTURL=<set-locally-in-your-secret-store>
UPSTASH__REDIS__RESTTOKEN=<set-locally-in-your-secret-store>

# ===== Upstash Blob Storage (S3-compatible via Cloudflare R2) =====
# When UPSTASH__BLOB__TOKEN is set, the DI container prefers UpstashBlobStorageService
# over the generic S3StorageService. See ExternalServices.cs:62-69.
UPSTASH__BLOB__TOKEN=<set-locally-in-your-secret-store-optional>
# Hotfix 10.8c — optional R2 endpoint override for UpstashS3ClientFactory. Set this ONLY
# if the /v1/credentials response hands back a non-R2 endpoint (production incident
# 10.8c: https://smashing-kiwi-127167.upstash.io -> S3 "Access Denied"). Value must be
# an absolute https URL, e.g. https://<account-id>.r2.cloudflarestorage.com
UPSTASH__BLOB__S3ENDPOINT=<optional-override-of-the-credentials-response-endpoint>

# ===== JWT =====
JWT_SECRET=<generate-a-unique-32-byte-minimum-secret-locally>
JWT_ISSUER=CMS
JWT_AUDIENCE=CMS-Users
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ===== CORS (Frontend URLs) =====
CORS_STUDENT_APP=http://localhost:5173
CORS_ADMIN_APP=http://localhost:5174

# ===== Vite Frontend =====
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# ===== S3-Compatible Private Storage (fallback when Upstash Blob not configured) =====
# Used by S3StorageService when UPSTASH__BLOB__TOKEN is absent.
STORAGE_S3_ENDPOINT=<set-to-your-s3-compatible-endpoint>
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_ACCESS_KEY=<set-locally-in-your-secret-store>
STORAGE_S3_SECRET_KEY=<set-locally-in-your-secret-store>
STORAGE_S3_BUCKET_NAME=cms-files

# ===== WhatsApp Business API (OTP) =====
WHATSAPP_TOKEN=<set-locally-in-your-secret-store>
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# ===== Firebase (Push Notifications) =====
FIREBASE_PROJECT_ID=cms-project
FIREBASE_SERVICE_ACCOUNT=<set-a-secret-manager-reference-locally>

# ===== Sentry (Error Monitoring) =====
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=development

# ===== Rate Limiting =====
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=5

# ===== Logging =====
LOG_LEVEL=Information
LOG_PATH=/app/logs

# ===== Feature Flags =====
FEATURE_OFFLINE_MODE=false
FEATURE_WATERMARK=true
FEATURE_DEVTOOLS_DETECTION=true
