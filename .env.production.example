# CMS Platform — Production Environment Template
# This template is safe to distribute. Do not place real values in repository files or release artifacts.
# Store production secrets only in the deployment platform's secret manager.

# ===== Application =====
NODE_ENV=production
APP_VERSION=1.0.0
TZ=Asia/Riyadh

# ===== PostgreSQL =====
POSTGRES_DB=cms
POSTGRES_USER=<set-in-secret-manager>
POSTGRES_PASSWORD=<set-in-secret-manager>
POSTGRES_HOST=<managed-postgres-host>
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_HOST=<managed-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<set-in-secret-manager>
REDIS_SSL=true

# ===== JWT / Session Security =====
JWT_SECRET=<set-in-secret-manager-minimum-32-random-bytes>
JWT_ISSUER=CMS
JWT_AUDIENCE=CMS-Users
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ===== CORS =====
CORS_STUDENT_APP=https://app.cms.example.com
CORS_ADMIN_APP=https://admin.cms.example.com

# ===== Vite Frontend =====
# This value is public by design. It must never contain a credential.
VITE_API_URL=https://api.cms.example.com/api/v1
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=<set-in-secret-manager>
R2_ACCESS_KEY=<set-in-secret-manager>
R2_SECRET_KEY=<set-in-secret-manager>
R2_BUCKET_NAME=<private-bucket-name>
R2_PUBLIC_URL=<leave-empty-for-private-paid-content>

# ===== Messaging and Push =====
WHATSAPP_TOKEN=<set-in-secret-manager>
WHATSAPP_PHONE_ID=<set-in-secret-manager>
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
FIREBASE_PROJECT_ID=<public-project-id>
FIREBASE_SERVICE_ACCOUNT=<set-in-secret-manager-or-mounted-secret-file>

# ===== Monitoring =====
SENTRY_DSN_BACKEND=<set-in-secret-manager>
SENTRY_DSN_FRONTEND=<public-dsn-if-used>
SENTRY_ENVIRONMENT=production

# ===== Security Controls =====
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=5
LOG_LEVEL=Information
LOG_PATH=/app/logs
FEATURE_OFFLINE_MODE=false
FEATURE_WATERMARK=true
FEATURE_DEVTOOLS_DETECTION=false
